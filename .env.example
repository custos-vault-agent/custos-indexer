# To create or update a token visit https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# =========================================
# Envio Indexer + Hasura (Custos)
# Salin ke .env lalu isi nilai yang WAJIB
#   cp .env.example .env
# =========================================

# ---------- Postgres ----------
ENVIO_PG_USER=postgres
# WAJIB. Generate: openssl rand -hex 32
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=envio-dev
ENVIO_PG_PUBLIC_SCHEMA=envio

# ---------- Hasura ----------
# WAJIB. Generate: openssl rand -hex 32
HASURA_GRAPHQL_ADMIN_SECRET=
# Biarkan false di server publik; pakai `hasura console` dari lokal
HASURA_GRAPHQL_ENABLE_CONSOLE=false

# ---------- Envio Indexer ----------
ENVIO_INDEXER_PORT=9898
CONFIG_FILE=config.yaml
# trace | debug | info | warn | error
LOG_LEVEL=info
# console-pretty | console-raw | ecs-file | file-only | ecs-console | both-prettyconsole
LOG_STRATEGY=console-pretty
TUI_OFF=true